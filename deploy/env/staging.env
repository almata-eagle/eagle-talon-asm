# Eagle Talon — STAGING identity. Committed on purpose: no secrets here.
# Runs beside prod on core with its own containers, ports and data volume.
#
#   UI   http://core:8098        (prod is 8088)
#   API  127.0.0.1:8100          (loopback only; nginx proxies /api/*)
#   Data volume eagle-talon-staging-data  (seed it from a prod backup with
#        deploy/seed-staging-db.sh — staging never mounts the prod volume)
#
# Scheduled monitoring is OFF so staging doesn't re-scan every client domain
# a second time or spend the shared NVD quota. Use "Check now" to test it.
EAGLE_TALON_ENV=staging
STACK_NAME=eagle-talon-staging
DATA_VOLUME=eagle-talon-staging-data
EAGLE_TALON_WEB_PORT=8098
API_HOST=127.0.0.1
API_PORT=8100
EAGLE_TALON_SCHEDULER=off
# SOC hot store written by the log collector (soc/), mounted read-only.
SOC_HOT_DIR=/home/eddy/eagle-soc/hot
# SOC: detect every 5 min; Claude triage (key in secrets.env as
# ANTHROPIC_API_KEY, eagle-soc workspace). Prod triages the same logs, so
# staging gets a small budget: at most 5 triages per hour.
SOC_DETECT=on
SOC_DETECT_INTERVAL_S=300
SOC_TRIAGE=on
SOC_TRIAGE_MODEL=claude-sonnet-5-5
SOC_TRIAGE_MAX_PER_HOUR=5
# Threat intelligence. Spamhaus asks for at most one download a day per
# address, and prod already fetches it from this host, so staging leaves the
# two Spamhaus feeds out.
SOC_INTEL=on
SOC_INTEL_FEEDS=feodo,tor_exits,blocklist_de,threatfox
# Talon OT (http://core:8098/ot.html). Set OT_SETUP_CODE in secrets.env
# before first use so only you can create the first admin.
OT_ENABLED=on
# SOC alerts (docs/SOC-ALERTS.md). SOC_NTFY_TOPIC, SOC_SLACK_WEBHOOK and
# SOC_ALERT_SECRET go in this checkout's secrets.env. Prod alerts stay off
# until v0.6.0; after that, give staging its own topic or switch it off here.
SOC_ALERTS=on
SOC_ALERT_BASE_URL=http://core:8098
SOC_ALERT_QUIET=23:00-07:00
