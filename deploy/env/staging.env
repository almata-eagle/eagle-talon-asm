# Eagle Talon — STAGING identity. Committed on purpose: no secrets here.
# Runs beside prod on core with its own containers, ports and data volume.
#
#   UI   http://core:8098        (prod is 8088)
#   API  127.0.0.1:8100          (loopback only; nginx proxies /api/*)
#   Data volume eagle-talon-staging-data  (seed it from a prod backup with
#        deploy/seed-staging-db.sh — staging never mounts the prod volume)
#
# Scheduled monitoring is OFF so staging doesn't re-scan every client domain
# a second time or spend the shared NVD quota. Use "Check now" to test it.
EAGLE_TALON_ENV=staging
STACK_NAME=eagle-talon-staging
DATA_VOLUME=eagle-talon-staging-data
EAGLE_TALON_WEB_PORT=8098
API_HOST=127.0.0.1
API_PORT=8100
EAGLE_TALON_SCHEDULER=off
