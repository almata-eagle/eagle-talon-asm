# Eagle Talon — PRODUCTION identity. Committed on purpose: no secrets here.
# Secrets (NVD_API_KEY, later ANTHROPIC_API_KEY) live in deploy/secrets.env,
# which is gitignored. deploy/deploy.sh loads this file LAST, so these values
# always win over anything in secrets.env or a legacy deploy/.env.
#
# Do not change STACK_NAME or DATA_VOLUME: Eagle Eye mounts "eagle-talon-data",
# and the container names are what Portainer/Uptime Kuma already watch.
EAGLE_TALON_ENV=prod
STACK_NAME=eagle-talon
DATA_VOLUME=eagle-talon-data
EAGLE_TALON_WEB_PORT=8088
API_HOST=0.0.0.0
API_PORT=8000
EAGLE_TALON_SCHEDULER=on
