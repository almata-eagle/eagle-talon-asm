# Eagle SOC collector — where things live on core. Committed: no secrets here.
# soc/deploy-collector.sh reads this file; anything starting with ~ is
# expanded to eddy's home directory.

# Hot store: plain NDJSON on Core's NVMe, searched by Talon/Claude.
SOC_HOT_DIR=~/eagle-soc/hot
# Vector's checkpoints and disk buffer (holds archive data while the NAS is away).
SOC_STATE_DIR=~/eagle-soc/vector
# Long-term archive on the NAS `logs` share (never the `finance` share).
SOC_NAS_MOUNT=/mnt/nas/logs
SOC_ARCHIVE_DIR=/mnt/nas/logs/eagle-soc/archive
# Suricata's log folder on core (eve.json inside).
SURICATA_LOG_DIR=/var/log/suricata

# Retention (days), applied daily by soc/retention.sh.
SOC_HOT_DAYS=30
SOC_ARCHIVE_DAYS=400

# Who may send syslog: the FortiGate's LAN address. preflight.sh suggests the
# matching UFW rule. Leave empty to have preflight show the default gateway.
SOC_SYSLOG_ALLOW_FROM=192.168.10.1
